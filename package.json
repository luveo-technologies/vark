{
  "name": "vark-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for vark — zero-trust security runtime for AI agent tool calls.",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "demo": "pnpm build && tsx examples/demo.ts",
    "bench": "node examples/bench-scanners.mjs",
    "docs:check": "node examples/check-docs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "pnpm --recursive run clean"
  },
  "dependencies": {
    "@saturn/vark": "workspace:*",
    "@saturn/vark-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "2.1.9"
  }
}
