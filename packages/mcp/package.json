{
  "name": "@luveo-tech/vark-mcp",
  "version": "0.2.0-beta.3",
  "description": "MCP adapter for @luveo-tech/vark — wrap Anthropic Model Context Protocol tools with vark's zero-trust security gates (no rewrites).",
  "keywords": [
    "vark",
    "mcp",
    "model-context-protocol",
    "anthropic",
    "ai-agents",
    "llm-security",
    "agent-security",
    "tool-calls",
    "security",
    "zero-trust"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@luveo-tech/vark": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
