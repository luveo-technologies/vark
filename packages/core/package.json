{
  "name": "@luveo-tech/vark",
  "version": "0.2.0-beta.3",
  "description": "Zero-trust security runtime & firewall for AI agent tool calls — 8-gate pipeline (circuit breaker, DLP, prompt-injection filter, sandbox, audit chain) for LLM tools.",
  "keywords": [
    "vark",
    "security",
    "zero-trust",
    "firewall",
    "ai-agents",
    "llm",
    "llm-security",
    "agent-security",
    "prompt-injection",
    "dlp",
    "secret-redaction",
    "sandbox",
    "audit-log",
    "tool-calls",
    "mcp",
    "guardrails"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vark": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  }
}
